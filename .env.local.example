# ----------------------------------------
# CLAVES PÚBLICAS DE SUPABASE (PASO 3)
# Requeridas para el frontend
# ----------------------------------------
NEXT_PUBLIC_SUPABASE_URL=TU_SUPABASE_URL_AQUI
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_SUPABASE_ANON_KEY_AQUI

# ----------------------------------------
# CLAVES DE SUPABASE OAUTH (PASO 6)
# Requeridas para Google Login en el panel de Supabase
# ----------------------------------------
# GOOGLE_CLIENT_ID=CONFIGURAR_EN_EL_PANEL_DE_SUPABASE
# GOOGLE_CLIENT_SECRET=CONFIGURAR_EN_EL_PANEL_DE_SUPABASE

# ----------------------------------------
# CLAVES DE CLOUDFLARE TURNSTILE
# ----------------------------------------
# Para pruebas locales puedes usar las claves de prueba de Cloudflare:
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=